---
---

<section class="relative bg-[#0A0A0A] overflow-hidden">
  <!-- Dot grid — very subtle -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
    style="background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1px); background-size: 32px 32px; mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);">
  </div>

  <!-- Gold radial glow — off-center, more dramatic -->
  <div class="absolute pointer-events-none" aria-hidden="true"
    style="top: -10%; left: 50%; transform: translateX(-50%); width: 800px; height: 800px; background: radial-gradient(circle, rgba(212,175,55,0.07) 0%, rgba(0,255,65,0.04) 35%, transparent 70%); border-radius: 50%;">
  </div>

  <!-- Main content -->
  <div class="relative z-10 max-w-5xl mx-auto px-6 pt-32 sm:pt-36 pb-0 text-center">

    <!-- Eyebrow -->
    <div class="inline-flex items-center gap-2 mb-5 px-4 py-1.5 rounded-full animate-fade-up"
      style="border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.025);">
      <span class="w-1.5 h-1.5 rounded-full bg-[#00FF41] animate-pulse-green flex-shrink-0"></span>
      <span style="font-size: 10px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.16em; color: rgba(255,255,255,0.35);">Autonomous AI Lead Infrastructure</span>
    </div>

    <!-- H1 — 2 clean lines, tight -->
    <h1 class="font-black animate-fade-up delay-100" style="letter-spacing: -0.04em; line-height: 0.95; margin-bottom: 1.75rem;">
      <span class="block text-white" style="font-size: clamp(3rem, 8vw, 7.5rem);">Stop the Silent Revenue</span>
      <span class="block" style="font-size: clamp(3rem, 8vw, 7.5rem); background: linear-gradient(135deg, #D4AF37 0%, #F5D06B 45%, #C9A227 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; filter: drop-shadow(0 0 32px rgba(212,175,55,0.4)); padding-bottom: 0.15em; display: block;">Hemorrhage.</span>
    </h1>

    <!-- Glow line -->
    <div class="mx-auto mb-7 animate-fade-up delay-200" style="height: 1px; max-width: 260px; background: linear-gradient(90deg, transparent, rgba(212,175,55,0.4), transparent);"></div>

    <!-- Sub-headline -->
    <p class="mx-auto mb-10 leading-relaxed animate-fade-up delay-300"
      style="color: rgba(255,255,255,0.45); font-size: clamp(1rem, 1.8vw, 1.15rem); max-width: 38rem; letter-spacing: -0.01em;">
      You're paying for attention you don't own. Every visitor who leaves without a trace is capital evaporated.
      We install the <span style="color: rgba(255,255,255,0.85); font-weight: 600;">Autonomous Infrastructure</span> that captures,
      nurtures, and closes your leads <span style="color: rgba(255,255,255,0.85); font-weight: 600;">24/7.</span>
    </p>

    <!-- Hero URL scanner — primary CTA -->
    <div class="animate-fade-up delay-400 mb-5" style="max-width: 560px; margin-left: auto; margin-right: auto;">
      <form id="hero-score-form" style="display:flex; gap:8px; width:100%;">
        <input
          id="hero-url-input"
          type="url"
          placeholder="https://yoursite.com"
          required
          style="
            flex:1; padding:14px 18px;
            background:rgba(255,255,255,0.05);
            border:1px solid rgba(255,255,255,0.12);
            border-radius:4px; color:#fff;
            font-size:0.95rem; font-family:'Inter',sans-serif;
            outline:none; min-width:0;
          "
        />
        <button type="submit" style="
          padding:14px 22px;
          background:#D4AF37; color:#000;
          font-weight:800; font-size:0.9rem;
          border:none; border-radius:4px;
          cursor:pointer; white-space:nowrap;
          font-family:'Inter',sans-serif;
          letter-spacing:-0.01em;
        ">
          Get My Score &rarr;
        </button>
      </form>
      <p style="font-size:11px; color:rgba(255,255,255,0.2); margin:10px 0 0; font-family:monospace; letter-spacing:0.04em;">
        FREE &nbsp;·&nbsp; NO ACCOUNT &nbsp;·&nbsp; RESULTS IN 30 SECONDS
      </p>
    </div>

    <!-- Secondary CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14 animate-fade-up delay-500">
      <a href="#diagnostic"
        style="font-size:0.85rem; color:rgba(255,255,255,0.35); text-decoration:none; letter-spacing:-0.01em; transition:color 0.2s;"
        onmouseover="this.style.color='rgba(255,255,255,0.65)'" onmouseout="this.style.color='rgba(255,255,255,0.35)'">
        Want the full revenue audit instead &rarr;
      </a>
      <span style="color:rgba(255,255,255,0.1); font-size:12px;" class="hidden sm:inline">|</span>
      <a href="#results"
        style="font-size:0.85rem; color:rgba(255,255,255,0.35); text-decoration:none; letter-spacing:-0.01em; transition:color 0.2s;"
        onmouseover="this.style.color='rgba(255,255,255,0.65)'" onmouseout="this.style.color='rgba(255,255,255,0.35)'">
        See real results &rarr;
      </a>
    </div>

    <!-- Social proof micro-strip -->
    <div class="flex items-center justify-center gap-5 mb-14 animate-fade-up delay-500">
      <div class="flex -space-x-2">
        {['M','J','D','S','K'].map((l, i) => (
          <div class="w-7 h-7 rounded-full border-2 border-[#0A0A0A] flex items-center justify-center text-[10px] font-black"
            style={`background: hsl(${i * 47 + 140}, 30%, 20%); color: rgba(255,255,255,0.7);`}>{l}</div>
        ))}
      </div>
      <span style="font-size: 11px; color: rgba(255,255,255,0.3); letter-spacing: -0.01em;">
        <span style="color: rgba(255,255,255,0.6); font-weight: 700;">47+ operators</span> deployed · avg <span style="color: #00FF41; font-weight: 700;">340% ROI</span>
      </span>
    </div>

    <!-- Metrics row -->
    <div id="hero-metrics" class="grid grid-cols-3 gap-px max-w-lg mx-auto rounded-sm overflow-hidden animate-fade-up delay-500" style="background: rgba(255,255,255,0.04);">
      <div class="hero-metric-cell px-4 py-5 text-center" style="background: #0F0F0F;">
        <div class="font-black text-[#00FF41] tabular-nums" style="font-size: clamp(1.3rem, 5vw, 2.2rem); letter-spacing: -0.03em;">18s</div>
        <div class="hero-metric-label" style="font-size: 9px; color: rgba(255,255,255,0.3); margin-top: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em;">Avg. Response</div>
      </div>
      <div class="hero-metric-cell px-4 py-5 text-center" style="background: #0F0F0F;">
        <div class="font-black text-white tabular-nums" style="font-size: clamp(1.3rem, 5vw, 2.2rem); letter-spacing: -0.03em;">340%</div>
        <div class="hero-metric-label" style="font-size: 9px; color: rgba(255,255,255,0.3); margin-top: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em;">ROI / 90 Days</div>
      </div>
      <div class="hero-metric-cell px-4 py-5 text-center" style="background: #0F0F0F;">
        <div class="font-black text-white tabular-nums" style="font-size: clamp(1.3rem, 5vw, 2.2rem); letter-spacing: -0.03em;">24/7</div>
        <div class="hero-metric-label" style="font-size: 9px; color: rgba(255,255,255,0.3); margin-top: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em;">Always On</div>
      </div>
    </div>

    <!-- Scroll cue -->
    <div class="mt-12 flex flex-col items-center gap-2 pb-6" style="color: rgba(255,255,255,0.15);">
      <div class="w-px h-10 bg-gradient-to-b from-transparent via-white/15 to-transparent"></div>
    </div>
  </div>

  <script>
    document.getElementById('hero-score-form')?.addEventListener('submit', function(e) {
      e.preventDefault();
      const input = document.getElementById('hero-url-input') as HTMLInputElement;
      const url = input.value.trim();
      if (!url) return;
      window.location.href = '/score?url=' + encodeURIComponent(url);
    });
  </script>

  <style>
    /* Stack form vertically on small screens */
    @media (max-width: 520px) {
      #hero-score-form {
        flex-direction: column !important;
      }
      #hero-score-form button[type="submit"] {
        width: 100%;
        padding: 14px 16px !important;
        font-size: 0.95rem !important;
      }
    }

    /* Tighter metric cells on small screens */
    @media (max-width: 420px) {
      .hero-metric-cell {
        padding: 12px 6px !important;
      }
      .hero-metric-label {
        font-size: 8px !important;
        letter-spacing: 0.05em !important;
      }
    }
  </style>

  <!-- Ticker tape — in normal flow, zero overlap possible -->
  <div style="border-top: 1px solid rgba(255,255,255,0.04); padding: 12px 0; overflow: hidden; background: rgba(10,10,10,0.9);">
    <div class="animate-ticker flex gap-20 whitespace-nowrap" aria-hidden="true">
      <span style="color: rgba(255,255,255,0.2); font-size: 10px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.14em;">$2.4M Revenue Recovered Q1 2026</span>
      <span style="color: rgba(0,255,65,0.35); font-size: 10px;">◆</span>
      <span style="color: rgba(255,255,255,0.2); font-size: 10px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.14em;">47+ High-Ticket Operators Deployed</span>
      <span style="color: rgba(0,255,65,0.35); font-size: 10px;">◆</span>
      <span style="color: rgba(255,255,255,0.2); font-size: 10px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.14em;">Average 340% ROI in 90 Days</span>
      <span style="color: rgba(0,255,65,0.35); font-size: 10px;">◆</span>
      <span style="color: rgba(255,255,255,0.2); font-size: 10px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.14em;">Lead Response Time: 18 Seconds</span>
      <span style="color: rgba(0,255,65,0.35); font-size: 10px;">◆</span>
      <span style="color: rgba(255,255,255,0.2); font-size: 10px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.14em;">$2.4M Revenue Recovered Q1 2026</span>
      <span style="color: rgba(0,255,65,0.35); font-size: 10px;">◆</span>
      <span style="color: rgba(255,255,255,0.2); font-size: 10px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.14em;">47+ High-Ticket Operators Deployed</span>
      <span style="color: rgba(0,255,65,0.35); font-size: 10px;">◆</span>
      <span style="color: rgba(255,255,255,0.2); font-size: 10px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.14em;">Average 340% ROI in 90 Days</span>
      <span style="color: rgba(0,255,65,0.35); font-size: 10px;">◆</span>
      <span style="color: rgba(255,255,255,0.2); font-size: 10px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.14em;">Lead Response Time: 18 Seconds</span>
      <span style="color: rgba(0,255,65,0.35); font-size: 10px;">◆</span>
    </div>
  </div>
</section>
