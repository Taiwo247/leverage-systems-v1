---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Revenue Score — LeverageSystems"
  description="Enter your website URL and get your Revenue Health Score in 30 seconds. Free. Find out exactly where your site is bleeding money."
>
  <Navbar />

  <main id="score-page">

    <!-- ── IDLE: URL input ── -->
    <section id="state-idle" class="score-section">
      <div class="score-container">
        <p class="score-eyebrow">FREE REVENUE FORENSICS SCAN</p>
        <h1 class="score-headline">What's your<br/><span class="score-gold">Revenue Score?</span></h1>
        <p class="score-subhead">
          Enter your website URL. Our AI scans your site for conversion failures,
          tracking gaps, and revenue leaks — in under 30 seconds.
        </p>

        <form id="url-form" class="score-form" autocomplete="off">
          <div class="score-input-row">
            <input
              id="url-input"
              type="url"
              placeholder="https://yoursite.com"
              required
              class="score-input"
              autocomplete="off"
            />
            <button type="submit" class="score-btn" id="scan-btn">
              Scan My Site &rarr;
            </button>
          </div>
          <p id="url-error" class="score-error" style="display:none"></p>
        </form>

        <p class="score-footnote">No account needed. No credit card. Takes 20–30 seconds.</p>
      </div>
    </section>

    <!-- ── SCANNING: loading ── -->
    <section id="state-scanning" class="score-section" style="display:none">
      <div class="score-container">
        <div class="scan-animation">
          <div class="scan-pulse"></div>
          <div class="scan-ring"></div>
        </div>
        <p class="scan-domain" id="scan-domain-label"></p>
        <div class="scan-steps" id="scan-steps">
          <p class="scan-step active" id="step-1">&#x25B6; Taking screenshot...</p>
          <p class="scan-step" id="step-2">&#x25B6; Analyzing revenue infrastructure...</p>
          <p class="scan-step" id="step-3">&#x25B6; Calculating your score...</p>
        </div>
      </div>
    </section>

    <!-- ── RESULTS ── -->
    <section id="state-results" class="score-section" style="display:none">
      <div class="score-container score-container--wide">

        <p class="score-eyebrow">REVENUE FORENSICS REPORT</p>
        <p class="results-domain" id="results-domain"></p>

        <!-- Score display -->
        <div class="results-score-row">
          <div class="results-score-block">
            <p class="results-score-label">REVENUE HEALTH SCORE</p>
            <div class="results-score-number-row">
              <span class="results-score-num" id="results-score-num">—</span>
              <span class="results-score-denom">/100</span>
            </div>
            <!-- 3-zone bar -->
            <div class="results-bar-wrap">
              <div class="results-bar-track">
                <div class="results-bar-red"></div>
                <div class="results-bar-orange"></div>
                <div class="results-bar-green"></div>
                <div class="results-bar-dim" id="results-bar-dim"></div>
                <div class="results-bar-tick" id="results-bar-tick"></div>
              </div>
              <div class="results-bar-labels">
                <span style="color:#c32323">CRITICAL</span>
                <span style="color:#c86e00">AT RISK</span>
                <span style="color:#197a37">OPTIMIZED</span>
              </div>
            </div>
          </div>

          <div class="results-verdict" id="results-verdict"></div>
        </div>

        <!-- Findings -->
        <div class="findings-grid" id="findings-grid"></div>

        <!-- Email gate -->
        <div class="results-gate">
          <div class="gate-inner">
            <p class="gate-label">GET THE FULL REVENUE FORENSICS REPORT</p>
            <h2 class="gate-headline">Your PDF briefing is ready.</h2>
            <p class="gate-sub">
              The complete report includes exact dollar estimates, a ranked fix list, and a
              30-day revenue recovery plan. Delivered to your inbox in minutes.
            </p>
            <form id="email-form" class="gate-form">
              <div class="score-input-row">
                <input
                  id="email-input"
                  type="email"
                  placeholder="your@email.com"
                  required
                  class="score-input"
                />
                <button type="submit" class="score-btn score-btn--green" id="email-btn">
                  Send My Report &rarr;
                </button>
              </div>
              <p id="email-error" class="score-error" style="display:none"></p>
            </form>
          </div>
        </div>

      </div>
    </section>

    <!-- ── SUBMITTED: thank you ── -->
    <section id="state-submitted" class="score-section" style="display:none">
      <div class="score-container score-container--center">
        <div class="submitted-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#00FF41" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <h2 class="submitted-headline">Report incoming.</h2>
        <p class="submitted-sub">
          Your full Revenue Forensics Briefing is being generated and will arrive in your inbox
          within the next 5 minutes. Check spam if it doesn't appear.
        </p>
        <a href="/" class="submitted-back">&#x2190; Back to LeverageSystems</a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  #score-page {
    min-height: 100vh;
    background: #08080f;
    display: flex;
    flex-direction: column;
  }

  .score-section {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 20px 60px;
  }

  .score-container {
    width: 100%;
    max-width: 580px;
    margin: 0 auto;
  }

  .score-container--wide {
    max-width: 720px;
  }

  .score-container--center {
    text-align: center;
    max-width: 480px;
  }

  .score-eyebrow {
    font-size: 10px;
    font-family: monospace;
    letter-spacing: 0.14em;
    color: rgba(212,175,55,0.6);
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .score-headline {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1.1;
    margin: 0 0 20px;
  }

  .score-gold { color: #D4AF37; }

  .score-subhead {
    font-size: 1rem;
    color: rgba(255,255,255,0.5);
    line-height: 1.7;
    margin: 0 0 36px;
    max-width: 480px;
  }

  .score-form { width: 100%; }

  .score-input-row {
    display: flex;
    gap: 10px;
    width: 100%;
  }

  .score-input {
    flex: 1;
    padding: 14px 18px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 4px;
    color: #fff;
    font-size: 15px;
    font-family: 'Inter', sans-serif;
    outline: none;
    transition: border-color 0.2s;
  }

  .score-input:focus { border-color: rgba(212,175,55,0.5); }
  .score-input::placeholder { color: rgba(255,255,255,0.25); }

  .score-btn {
    padding: 14px 22px;
    background: #D4AF37;
    color: #000;
    font-weight: 800;
    font-size: 14px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s;
    font-family: 'Inter', sans-serif;
  }

  .score-btn:hover { opacity: 0.88; }
  .score-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .score-btn--green { background: #00FF41; }

  .score-error {
    color: #ef4444;
    font-size: 13px;
    margin: 8px 0 0;
  }

  .score-footnote {
    font-size: 12px;
    color: rgba(255,255,255,0.2);
    margin: 16px 0 0;
    font-family: monospace;
  }

  /* Scanning state */
  .scan-animation {
    position: relative;
    width: 72px;
    height: 72px;
    margin: 0 auto 28px;
  }

  .scan-pulse {
    position: absolute;
    inset: 20px;
    background: #D4AF37;
    border-radius: 50%;
    animation: pulse 1.4s ease-in-out infinite;
  }

  .scan-ring {
    position: absolute;
    inset: 0;
    border: 2px solid rgba(212,175,55,0.3);
    border-radius: 50%;
    animation: ring 1.4s ease-in-out infinite;
  }

  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.4;transform:scale(0.85)} }
  @keyframes ring  { 0%{transform:scale(0.8);opacity:0.8} 100%{transform:scale(1.5);opacity:0} }

  .scan-domain {
    font-size: 13px;
    font-family: monospace;
    color: rgba(212,175,55,0.7);
    text-align: center;
    margin: 0 0 28px;
    letter-spacing: 0.06em;
  }

  .scan-steps { max-width: 320px; margin: 0 auto; }

  .scan-step {
    font-size: 13px;
    font-family: monospace;
    color: rgba(255,255,255,0.18);
    padding: 6px 0;
    transition: color 0.3s;
    margin: 0;
  }

  .scan-step.active { color: rgba(0,255,65,0.8); }
  .scan-step.done   { color: rgba(255,255,255,0.35); }

  /* Results */
  .results-domain {
    font-size: 12px;
    font-family: monospace;
    color: rgba(255,255,255,0.3);
    letter-spacing: 0.06em;
    margin: 0 0 28px;
    text-transform: uppercase;
  }

  .results-score-row {
    display: flex;
    gap: 32px;
    align-items: flex-start;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .results-score-block { flex: 0 0 auto; }

  .results-score-label {
    font-size: 9px;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.3);
    font-family: monospace;
    margin: 0 0 6px;
    text-transform: uppercase;
  }

  .results-score-number-row {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 10px;
  }

  .results-score-num {
    font-size: 64px;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    font-family: 'Inter', sans-serif;
  }

  .results-score-denom {
    font-size: 20px;
    font-weight: 400;
    color: rgba(255,255,255,0.25);
    font-family: 'Inter', sans-serif;
  }

  .results-bar-wrap { width: 220px; }

  .results-bar-track {
    position: relative;
    height: 6px;
    border-radius: 3px;
    overflow: visible;
    display: flex;
    margin-bottom: 6px;
  }

  .results-bar-red    { flex: 0 0 40%; background: #c32323; border-radius: 3px 0 0 3px; }
  .results-bar-orange { flex: 0 0 25%; background: #c86e00; }
  .results-bar-green  { flex: 0 0 35%; background: #197a37; border-radius: 0 3px 3px 0; }

  .results-bar-dim {
    position: absolute;
    top: 0;
    height: 6px;
    background: rgba(20,20,35,0.82);
    border-radius: 0 3px 3px 0;
    transition: width 0.6s ease;
  }

  .results-bar-tick {
    position: absolute;
    top: -3px;
    width: 3px;
    height: 12px;
    background: #fff;
    border-radius: 2px;
    transform: translateX(-50%);
    transition: left 0.6s ease;
    box-shadow: 0 0 4px rgba(255,255,255,0.6);
  }

  .results-bar-labels {
    display: flex;
    justify-content: space-between;
    font-size: 8px;
    font-family: monospace;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .results-verdict {
    flex: 1;
    min-width: 220px;
    padding: 16px 20px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-left: 3px solid #D4AF37;
    border-radius: 4px;
    font-size: 14px;
    color: rgba(255,255,255,0.55);
    line-height: 1.7;
    font-style: italic;
  }

  /* Findings */
  .findings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
    margin-bottom: 36px;
  }

  .finding-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 4px;
    padding: 16px 18px;
  }

  .finding-num {
    font-size: 10px;
    font-family: monospace;
    color: #D4AF37;
    letter-spacing: 0.1em;
    margin: 0 0 8px;
  }

  .finding-text {
    font-size: 13px;
    color: rgba(255,255,255,0.7);
    line-height: 1.6;
    margin: 0;
  }

  /* Gate */
  .results-gate {
    border: 1px solid rgba(212,175,55,0.2);
    border-radius: 6px;
    overflow: hidden;
    position: relative;
  }

  .results-gate::before {
    content: '';
    display: block;
    height: 2px;
    background: linear-gradient(to right, transparent, #D4AF37, transparent);
  }

  .gate-inner { padding: 28px 28px 32px; }

  .gate-label {
    font-size: 9px;
    font-family: monospace;
    letter-spacing: 0.14em;
    color: rgba(212,175,55,0.6);
    text-transform: uppercase;
    margin: 0 0 10px;
  }

  .gate-headline {
    font-size: 1.6rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 10px;
  }

  .gate-sub {
    font-size: 14px;
    color: rgba(255,255,255,0.45);
    line-height: 1.7;
    margin: 0 0 24px;
  }

  .gate-form { width: 100%; }

  /* Submitted */
  .submitted-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(0,255,65,0.08);
    border: 1px solid rgba(0,255,65,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
  }

  .submitted-headline {
    font-size: 2rem;
    font-weight: 900;
    color: #fff;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }

  .submitted-sub {
    font-size: 15px;
    color: rgba(255,255,255,0.45);
    line-height: 1.7;
    margin: 0 0 32px;
  }

  .submitted-back {
    font-size: 13px;
    color: rgba(255,255,255,0.3);
    text-decoration: none;
    font-family: monospace;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }

  .submitted-back:hover { color: rgba(255,255,255,0.6); }

  @media (max-width: 520px) {
    .score-input-row { flex-direction: column; }
    .results-score-row { flex-direction: column; }
    .results-bar-wrap { width: 100%; }
    .gate-inner { padding: 20px 18px 24px; }
  }
</style>

<script>
  const VERDICTS: Record<string, string> = {
    critical:  'This site is in revenue emergency. Every day without fixes is money permanently lost.',
    risk:      'Significant conversion failures detected. Your traffic is working harder than your site is.',
    good:      'Solid foundation — but the gaps we found are still costing you compounding revenue.',
  };

  function show(id: string) {
    ['state-idle','state-scanning','state-results','state-submitted'].forEach(s => {
      const el = document.getElementById(s);
      if (el) el.style.display = s === id ? 'flex' : 'none';
    });
  }

  function setScore(score: number) {
    const num = document.getElementById('results-score-num')!;
    const tick = document.getElementById('results-bar-tick')!;
    const dim  = document.getElementById('results-bar-dim')!;
    const verdict = document.getElementById('results-verdict')!;

    // Color
    const color = score < 40 ? '#ef4444' : score < 65 ? '#f97316' : '#22c55e';
    num.style.color = color;
    num.textContent = String(score);

    // Bar
    const pct = score / 100;
    tick.style.left = `${pct * 100}%`;
    dim.style.left  = `${pct * 100}%`;
    dim.style.width = `${(1 - pct) * 100}%`;

    // Verdict
    const key = score < 40 ? 'critical' : score < 65 ? 'risk' : 'good';
    verdict.textContent = VERDICTS[key];
    verdict.style.borderLeftColor = color;
  }

  function setFindings(findings: string[]) {
    const grid = document.getElementById('findings-grid')!;
    grid.innerHTML = findings.map((f, i) => `
      <div class="finding-card">
        <p class="finding-num">0${i + 1}</p>
        <p class="finding-text">${f}</p>
      </div>
    `).join('');
  }

  function stepProgress(ms: number, stepId: string) {
    return new Promise<void>(resolve => {
      setTimeout(() => {
        document.querySelectorAll('.scan-step').forEach(el => {
          if (el.id === stepId) el.classList.add('active');
          else if (el.classList.contains('active')) {
            el.classList.remove('active');
            el.classList.add('done');
          }
        });
        resolve();
      }, ms);
    });
  }

  // ── URL form ──────────────────────────────────────────────────────────────
  let capturedUrl = '';
  let capturedDomain = '';

  document.getElementById('url-form')!.addEventListener('submit', async e => {
    e.preventDefault();
    const input = document.getElementById('url-input') as HTMLInputElement;
    const btn   = document.getElementById('scan-btn') as HTMLButtonElement;
    const errEl = document.getElementById('url-error')!;

    let url = input.value.trim();
    if (!url) return;
    if (!url.startsWith('http')) url = 'https://' + url;

    capturedUrl = url;
    try { capturedDomain = new URL(url).hostname.replace(/^www\./, ''); } catch {}

    btn.disabled = true;
    errEl.style.display = 'none';

    // Check session cache first — same URL in same session shows consistent score
    const cacheKey = 'ls_scan_' + url;
    const cached = sessionStorage.getItem(cacheKey);
    if (cached) {
      try {
        const data = JSON.parse(cached);
        document.getElementById('results-domain')!.textContent =
          `DOMAIN: ${(data.domain || capturedDomain).toUpperCase()}`;
        setScore(data.score);
        setFindings(data.findings || []);
        show('state-results');
        btn.disabled = false;
        return;
      } catch {}
    }

    // Show scanning state
    const domainLabel = document.getElementById('scan-domain-label')!;
    domainLabel.textContent = `SCANNING: ${capturedDomain.toUpperCase()}`;
    show('state-scanning');

    // Animate steps while waiting
    stepProgress(1200, 'step-1');
    stepProgress(5000, 'step-2');
    stepProgress(11000, 'step-3');

    try {
      const res  = await fetch('/api/quick-scan', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ url }),
      });
      const data = await res.json();

      if (!data.ok) throw new Error(data.error || 'Scan failed');

      // Cache result for this session
      sessionStorage.setItem(cacheKey, JSON.stringify({
        score: data.score, findings: data.findings, domain: data.domain,
      }));

      // Populate results
      document.getElementById('results-domain')!.textContent =
        `DOMAIN: ${(data.domain || capturedDomain).toUpperCase()}`;

      setScore(data.score);
      setFindings(data.findings || []);

      show('state-results');

    } catch (err: any) {
      show('state-idle');
      btn.disabled = false;
      errEl.textContent = err.message || 'Something went wrong — try again';
      errEl.style.display = 'block';
    }
  });

  // ── Auto-run from ?url= param ─────────────────────────────────────────────
  (function() {
    const params = new URLSearchParams(window.location.search);
    const preUrl = params.get('url');
    if (preUrl) {
      const input = document.getElementById('url-input') as HTMLInputElement;
      if (input) {
        input.value = preUrl;
        (document.getElementById('url-form') as HTMLFormElement)
          .dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
      }
    }
  })();

  // ── Email form ────────────────────────────────────────────────────────────
  document.getElementById('email-form')!.addEventListener('submit', async e => {
    e.preventDefault();
    const input  = document.getElementById('email-input') as HTMLInputElement;
    const btn    = document.getElementById('email-btn') as HTMLButtonElement;
    const errEl  = document.getElementById('email-error')!;
    const email  = input.value.trim();

    if (!email) return;
    btn.disabled   = true;
    btn.textContent = 'Sending...';
    errEl.style.display = 'none';

    try {
      const res  = await fetch('/api/score-submit', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ url: capturedUrl, email }),
      });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'Submission failed');
      // Meta Pixel — fire Lead on successful email capture so ad campaigns
      // optimize for real conversions (audit requests), not just clicks.
      try {
        if (typeof (window as any).fbq === 'function') {
          (window as any).fbq('track', 'Lead', { content_name: 'Revenue Score' });
        }
      } catch {}
      show('state-submitted');
    } catch (err: any) {
      btn.disabled    = false;
      btn.textContent = 'Send My Report →';
      errEl.textContent = err.message || 'Something went wrong — try again';
      errEl.style.display = 'block';
    }
  });
</script>
